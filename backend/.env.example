# 复制为 .env 后填入真实 key。字段名与 StoryCraft 一致，可直接复用那边的配置。

# ---------------- 通义千问（文本生成 + 可选的万相生图） ----------------
# 获取 API Key: https://bailian.console.aliyun.com/
API_KEY=sk-your-api-key-here
API_ENDPOINT=https://dashscope.aliyuncs.com/compatible-mode/v1
TEXT_MODEL=qwen-plus

# 文本 API 超时（秒）。批量生成图片提示词时推理较慢，读超时需放宽。
# 每次重试读超时翻倍：TEXT_TIMEOUT -> 2x -> 3x
TEXT_TIMEOUT=300
TEXT_MAX_RETRIES=3

# ---------------- 图片生成 ----------------
# 可选值: doubao 或 tongyi
# doubao: 支持组图生成，速度快，尺寸下限 3,686,400 像素
# tongyi: 稳定，wan2.6-t2i 质量高，要求约 1280~1440 见方
IMAGE_SERVICE=doubao

# 豆包 / 火山引擎 Ark。注意：这个 key 只用于豆包分支，不会发往通义接口。
# 获取 API Key: https://console.volcengine.com/ark
ARK_API_KEY=ark-your-api-key-here
ARK_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
DOUBAO_IMAGE_MODEL=doubao-seedream-4-5-251128

# 通义万相模型（走上面的 API_KEY）
TONGYI_IMAGE_MODEL=wan2.6-t2i

# 生图并发与请求间隔（秒）。两家都有 QPS 限制，调大容易触发限流。
IMAGE_CONCURRENCY=2
IMAGE_REQUEST_INTERVAL=3

# ---------------- 服务 ----------------
HOST=127.0.0.1
PORT=8000
# Playwright 导出时回连本服务，需与上面一致
# SELF_BASE_URL=http://127.0.0.1:8000

# ---------------- 存储 ----------------
# DATA_DIR=./data
